# Base image is pinned by multi-arch index digest. Refresh it with
# `node tools/agent/container/resolve-base-image-digests.mjs` (docker or podman).
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c

WORKDIR /app

COPY package.json /app/package.json
COPY tools/agent /app/tools/agent
# The project manual is baked into the image: no repository is mounted into the
# agent, so system-prompt.js falls back to AGENT_MANUAL_PATH.
COPY AGENT.md /app/AGENT.md

# /app stays owned by root so the agent cannot rewrite its own code.
# /workspace is an empty logical root: entrypoint.sh requires it to exist and the
# broker grants are scoped to that path string, but nothing is mounted there.
RUN groupadd --gid 10001 agent \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin agent \
    && mkdir -p /workspace \
    && chmod 0755 /app/tools/agent/container/entrypoint.sh

ENV AGENT_MANUAL_PATH=/app/AGENT.md

USER 10001:10001

ENTRYPOINT ["/app/tools/agent/container/entrypoint.sh"]
