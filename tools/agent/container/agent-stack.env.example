# Variables required by tools/agent/container/compose*.yml (names only, no values).
#
# Do not fill in this file inside the repository: the agent container mounts the
# repository at /workspace and can read it. Generate a real file outside the repo:
#
#   node tools/agent/container/gen-stack-secrets.mjs
#
# and pass it to both up and down:
#
#   podman compose --env-file <path> -f tools/agent/container/compose.yml up ...
#   podman compose --env-file <path> -f tools/agent/container/compose.yml down -v
#
# All three compose files need the BROKER_* variables. compose.yml also needs the
# worker credentials (the broker validates them because WORKER_AUTH_ENFORCE
# defaults to true).
BROKER_SCOPED_TOKEN_SECRET=
BROKER_MASTER_KEY_BASE64=
BROKER_ECDH_PRIVATE_KEY_BASE64=
BROKER_ECDH_PUBLIC_KEY_BASE64=
LINE_WORKER_AUTH_KEY_ID=
LINE_WORKER_AUTH_SHARED_SECRET=
FILE_WORKER_AUTH_KEY_ID=
FILE_WORKER_AUTH_SHARED_SECRET=
EXEC_ADAPTER_AUTH_KEY_ID=
EXEC_ADAPTER_AUTH_SHARED_SECRET=
