# Variables required by tools/agent/container/compose*.yml (names only, no values).
#
# Do not fill in this file inside the repository: the file worker serves the
# repository to the agent through the broker. Generate a real file outside the repo:
#
#   node tools/agent/container/gen-stack-secrets.mjs
#
# and pass it to both up and down:
#
#   podman compose --env-file <path> -f tools/agent/container/compose.yml up ...
#   podman compose --env-file <path> -f tools/agent/container/compose.yml down -v
#
# All three compose files need the BROKER_* variables (BROKER_REGISTRATION_SECRET is
# the seeded task's registration secret: the broker stores its hash and the agent
# registers with it). compose.yml also needs the
# worker credentials (the broker validates them because WORKER_AUTH_ENFORCE
# defaults to true), including the generation worker's, because compose expands
# every variable even for services whose profile is not started.
BROKER_SCOPED_TOKEN_SECRET=
BROKER_MASTER_KEY_BASE64=
BROKER_ECDH_PRIVATE_KEY_BASE64=
BROKER_ECDH_PUBLIC_KEY_BASE64=
BROKER_REGISTRATION_SECRET=
LINE_WORKER_AUTH_KEY_ID=
LINE_WORKER_AUTH_SHARED_SECRET=
FILE_WORKER_AUTH_KEY_ID=
FILE_WORKER_AUTH_SHARED_SECRET=
EXEC_ADAPTER_AUTH_KEY_ID=
EXEC_ADAPTER_AUTH_SHARED_SECRET=
GENERATION_WORKER_AUTH_KEY_ID=
GENERATION_WORKER_AUTH_SHARED_SECRET=
#
# Optional settings (compose uses the default when a variable is unset):
#   GENERATION_RETENTION_HOURS   hours generation-worker keeps a package in the
#                                generation-out volume (default 24, 1 to 8760)
