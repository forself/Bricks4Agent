{
  "name": "browser",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "metadata:build": "node ./ui_components/metadata/build-metadata.mjs",
    "metadata:check": "node ./ui_components/metadata/build-metadata.mjs --check",
    "custom-components:build": "node ./custom_components/build-registry.mjs",
    "custom-components:check": "node ./custom_components/build-registry.mjs --check",
    "test:custom-components": "node --test ./custom_components/custom-components.test.mjs ./custom_components/custom-runtime.test.mjs",
    "test": "node ./ui_components/editor/richtext-palette.test.mjs && node ./ui_components/utils/color-scale.test.mjs && node ./ui_components/utils/aggregation-engine.test.mjs && node ./ui_components/utils/force-engine.test.mjs"
  }
}
