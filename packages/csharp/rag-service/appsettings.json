{
  "RagService": {
    "DatabasePath": "rag-service.db",
    "InitializeSchema": true
  },
  "Embedding": {
    "Enabled": false,
    "Provider": "ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "nomic-embed-text",
    "Dimension": 768,
    "TimeoutSeconds": 30
  },
  "RagPipeline": {
    "OllamaBaseUrl": "http://localhost:11434",
    "QueryRewriteEnabled": false,
    "RerankEnabled": false,
    "CacheEnabled": false,
    "TimeoutSeconds": 60
  }
}
